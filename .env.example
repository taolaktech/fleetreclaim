# Copy to .env and load before starting the server (e.g. `set -a; . ./.env; set +a`).

# --- Frontend-safe Firebase web config (served to the browser by /api/config) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Server-only Firebase Admin credentials: never sent to the browser ---
# From the service account JSON (Project settings -> Service accounts).
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes; literal \n sequences are converted back to newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Local development without a Firebase project: run the app with no sign-in.
# Ignored whenever Admin credentials above are present.
# DEV_AUTH_BYPASS=1
