# Copy to .env and load before starting the server (e.g. `set -a; . ./.env; set +a`).

# --- Frontend-safe Firebase web config (served to the browser by /api/config) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Server-only Firebase Admin credentials: never sent to the browser ---
# From the service account JSON (Project settings -> Service accounts).
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes; literal \n sequences are converted back to newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Stripe billing: all server-only, never sent to the browser ---
# Test keys while developing (Stripe dashboard -> Developers -> API keys).
STRIPE_SECRET_KEY=sk_test_...
# Only needed if a future checkout is embedded in the page; Checkout is hosted today.
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` locally, or the webhook endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Recurring Price IDs for the one plan, one per billing interval.
# An interval without a Price ID is simply not offered.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# --- Google Analytics 4 ---
# Same measurement id as the marketing site, so one property covers the journey
# from fleetreclaim.com into the app. Public by design; unset disables analytics.
GA_MEASUREMENT_ID=

# Internal accounts: Firebase uids with full access and no Stripe subscription.
# Comma separated, server-only, never sent to the browser.
OWNER_FIREBASE_UIDS=

# Features that require an active subscription, comma separated: parse, evidence.
# Empty (the default) leaves everything available to every signed-in user.
# PAID_FEATURES=

# Local development without a Firebase project: run the app with no sign-in.
# Ignored whenever Admin credentials above are present.
# DEV_AUTH_BYPASS=1
